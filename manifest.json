{
  "manifest_version": 3,
  "name": "GitHub code review Vim keys",
  "version": "1.0.0",
  "description": "Review GitHub pull requests with Vim keys: j/k navigate files, x mark viewed, Space folds, p to submit, f opens Files changed.",
  "icons": {
    "16": "icons/paper-looking-glass-16.png",
    "32": "icons/paper-looking-glass-32.png",
    "48": "icons/paper-looking-glass-48.png",
    "128": "icons/paper-looking-glass-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
